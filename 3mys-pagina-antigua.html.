<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="3M&S — La fórmula digital. Agencia de publicidad especializada en marketing digital, contenido, pauta, redes sociales y experiencias transmedia.">
  <title>3M&S — La fórmula digital</title>
  <style>
    :root{
      --navy:#06264a;
      --navy-2:#0b3767;
      --orange:#ff7600;
      --orange-2:#ff9a2f;
      --cream:#f7f8fa;
      --ink:#11243b;
      --muted:#66758a;
      --white:#fff;
      --line:#dfe5ec;
      --shadow:0 18px 55px rgba(6,38,74,.12);
      --radius:24px;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{
      font-family:Arial, Helvetica, sans-serif;
      color:var(--ink);
      background:var(--white);
      line-height:1.55;
      overflow-x:hidden;
    }
    a{text-decoration:none;color:inherit}
    .container{width:min(1140px,92%);margin:auto}
    .orange{color:var(--orange)}
    .eyebrow{
      display:inline-flex;align-items:center;gap:9px;
      font-size:.78rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
      color:var(--orange);
    }
    .eyebrow:before{content:"";width:28px;height:3px;background:var(--orange);border-radius:99px}
    h1,h2,h3{line-height:1.05}
    h2{font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.04em}
    .section{padding:105px 0}
    .section-head{max-width:720px;margin-bottom:55px}
    .section-head h2{margin:14px 0 17px}
    .section-head p{color:var(--muted);font-size:1.06rem}

    /* NAV */
    .nav{
      position:fixed;top:0;left:0;width:100%;z-index:100;
      background:rgba(255,255,255,.9);backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(223,229,236,.8);
    }
    .nav-inner{height:78px;display:flex;align-items:center;justify-content:space-between}
    .brand img{width:145px;display:block}
    .links{display:flex;align-items:center;gap:28px;font-size:.92rem;font-weight:700;color:#41516a}
    .links a{transition:.2s}
    .links a:hover{color:var(--orange)}
    .nav-cta{
      background:var(--navy);color:white!important;padding:12px 18px;border-radius:99px
    }
    .nav-cta:hover{background:var(--orange)}
    .menu-btn{display:none;border:0;background:none;font-size:1.7rem;color:var(--navy)}

    /* HERO */
    .hero{
      min-height:100vh;padding:150px 0 85px;display:flex;align-items:center;
      background:
        radial-gradient(circle at 85% 20%, rgba(255,118,0,.14), transparent 25%),
        radial-gradient(circle at 10% 85%, rgba(6,38,74,.08), transparent 25%),
        linear-gradient(180deg,#fff 0%,#f8fafc 100%);
      position:relative;
    }
    .hero:after{
      content:"";position:absolute;right:-120px;bottom:-140px;width:440px;height:440px;
      border:1px solid rgba(6,38,74,.1);border-radius:50%;
      box-shadow:0 0 0 60px rgba(6,38,74,.025),0 0 0 120px rgba(6,38,74,.018);
    }
    .hero-grid{display:grid;grid-template-columns:1.03fr .97fr;gap:70px;align-items:center}
    .hero-logo{width:min(520px,100%);margin-bottom:28px}
    .hero h1{font-size:clamp(3.3rem,7vw,6.6rem);max-width:800px;color:var(--navy)}
    .hero h1 span{color:var(--orange)}
    .hero-sub{font-size:1.3rem;color:#40536c;max-width:650px;margin:24px 0 35px}
    .hero-actions{display:flex;gap:14px;flex-wrap:wrap}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:9px;
      padding:15px 23px;border-radius:12px;font-weight:800;border:2px solid var(--navy);
      transition:.25s;cursor:pointer
    }
    .btn-primary{background:var(--navy);color:white}
    .btn-primary:hover{background:var(--orange);border-color:var(--orange);transform:translateY(-2px)}
    .btn-light{background:white;color:var(--navy)}
    .btn-light:hover{border-color:var(--orange);color:var(--orange)}
    .formula-card{
      background:var(--navy);color:white;border-radius:32px;padding:42px;
      box-shadow:var(--shadow);position:relative;overflow:hidden;
    }
    .formula-card:before{
      content:"3M&S";position:absolute;right:-30px;top:-35px;font-size:8rem;font-weight:900;
      color:rgba(255,255,255,.035);letter-spacing:-.08em
    }
    .formula-card h3{font-size:1.15rem;text-transform:uppercase;letter-spacing:.08em;color:#b9c9db;margin-bottom:30px}
    .formula-line{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;align-items:center;gap:10px}
    .formula-item{text-align:center}
    .formula-item .circle{
      width:74px;height:74px;border:1px solid rgba(255,255,255,.35);border-radius:50%;
      display:grid;place-items:center;margin:0 auto 10px;color:white;font-weight:900;font-size:1.35rem
    }
    .formula-item:last-child .circle{background:var(--orange);border-color:var(--orange)}
    .formula-item small{display:block;color:#b9c9db;font-size:.7rem;line-height:1.3}
    .plus{font-size:1.7rem;color:var(--orange);font-weight:900}
    .formula-caption{margin-top:32px;padding-top:22px;border-top:1px solid rgba(255,255,255,.14);color:#dce6f0}

    /* ABOUT */
    .about{background:var(--cream)}
    .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
    .about-copy p{font-size:1.1rem;color:#53647a;margin-top:20px}
    .about-copy strong{color:var(--navy)}
    .statement{
      background:white;border-radius:var(--radius);padding:38px;box-shadow:var(--shadow);
      border-left:6px solid var(--orange)
    }
    .quote{font-size:1.65rem;font-weight:800;color:var(--navy);letter-spacing:-.03em}
    .quote-mark{font-size:5rem;color:var(--orange);line-height:.6}
    .chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}
    .chip{padding:9px 13px;border-radius:99px;background:#eef3f8;color:var(--navy);font-weight:700;font-size:.83rem}

    /* SERVICES */
    .services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .service{
      padding:30px 24px;border:1px solid var(--line);border-radius:20px;background:white;
      transition:.25s;position:relative;overflow:hidden
    }
    .service:hover{transform:translateY(-7px);box-shadow:var(--shadow);border-color:#ffd1a8}
    .service-icon{
      width:54px;height:54px;border-radius:15px;background:var(--navy);color:white;
      display:grid;place-items:center;font-size:1.35rem;margin-bottom:25px
    }
    .service:nth-child(even) .service-icon{background:var(--orange)}
    .service h3{font-size:1.15rem;margin-bottom:12px}
    .service p{color:var(--muted);font-size:.94rem}

    /* APPROACH */
    .approach{background:#f7f8fa}
    .approach-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px}
    .steps{display:grid;gap:0}
    .step{display:grid;grid-template-columns:58px 1fr;gap:18px;padding:0 0 28px;position:relative}
    .step:not(:last-child):after{
      content:"";position:absolute;left:28px;top:58px;width:2px;height:calc(100% - 32px);background:#dbe2ea
    }
    .step-num{
      width:58px;height:58px;border-radius:50%;display:grid;place-items:center;
      background:white;border:2px solid var(--navy);color:var(--navy);font-weight:900;z-index:1
    }
    .step:nth-child(2) .step-num,.step:nth-child(4) .step-num{border-color:var(--orange);color:var(--orange)}
    .step h3{font-size:1.15rem;margin:7px 0 7px}
    .step p{color:var(--muted);font-size:.93rem}
    .big-formula{
      background:var(--navy);border-radius:28px;color:white;padding:45px;
      display:flex;flex-direction:column;justify-content:center;box-shadow:var(--shadow)
    }
    .big-formula h3{font-size:1rem;color:#b9c9db;text-transform:uppercase;letter-spacing:.13em}
    .big-equation{font-size:clamp(2.5rem,5vw,4.5rem);font-weight:900;letter-spacing:-.07em;margin:30px 0 10px}
    .big-equation .o{color:var(--orange)}
    .big-formula p{color:#cfdae6;max-width:560px}

    /* TEAM */
    .team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .person{border:1px solid var(--line);border-radius:22px;padding:28px 20px;text-align:center;background:white}
    .avatar{
      width:90px;height:90px;margin:0 auto 20px;border-radius:50%;display:grid;place-items:center;
      background:linear-gradient(135deg,#eaf0f6,#fff);border:7px solid #fff;box-shadow:0 8px 25px rgba(6,38,74,.12);
      font-size:2rem;color:var(--navy);font-weight:900
    }
    .person:nth-child(even) .avatar{background:linear-gradient(135deg,#fff0e2,#fff)}
    .person h3{font-size:1rem}
    .role{display:block;color:var(--orange);font-weight:800;font-size:.76rem;text-transform:uppercase;margin:8px 0}
    .person p{font-size:.82rem;color:var(--muted)}

    /* CONTACT */
    .contact{background:var(--navy);color:white}
    .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:start}
    .contact .eyebrow{color:var(--orange)}
    .contact h2{margin:15px 0 20px}
    .contact-copy{color:#c9d5e3;font-size:1.05rem;max-width:520px}
    .contact-points{display:grid;gap:13px;margin-top:30px}
    .contact-point{display:flex;gap:12px;align-items:center;color:#e4ebf2}
    .contact-point b{color:var(--orange)}
    form{background:white;color:var(--ink);padding:32px;border-radius:24px}
    label{display:block;font-size:.78rem;font-weight:800;margin-bottom:7px}
    input,textarea{
      width:100%;padding:13px 14px;border:1px solid #d8e0e8;border-radius:10px;
      font:inherit;outline:none;margin-bottom:17px
    }
    input:focus,textarea:focus{border-color:var(--orange);box-shadow:0 0 0 3px rgba(255,118,0,.1)}
    textarea{min-height:120px;resize:vertical}
    form .btn{width:100%}
    .success{display:none;margin-top:13px;padding:12px;background:#eef8f1;color:#207044;border-radius:10px;font-size:.85rem;text-align:center}

    footer{background:#041c37;color:#aab8c8;padding:25px 0}
    .footer-inner{display:flex;justify-content:space-between;gap:20px;align-items:center;font-size:.82rem}
    .footer-brand{color:white;font-weight:900;font-size:1rem}
    .footer-brand span{color:var(--orange)}

    /* reveal */
    .reveal{opacity:1;transform:none;transition:none}
    .reveal.visible{opacity:1;transform:none}

    @media(max-width:900px){
      .links{display:none;position:absolute;top:78px;left:0;width:100%;background:white;padding:20px;flex-direction:column;align-items:flex-start;box-shadow:0 18px 30px rgba(6,38,74,.1)}
      .links.open{display:flex}
      .menu-btn{display:block}
      .hero-grid,.about-grid,.approach-grid,.contact-grid{grid-template-columns:1fr;gap:45px}
      .services-grid,.team-grid{grid-template-columns:repeat(2,1fr)}
      .hero{min-height:auto;padding-top:125px}
      .hero h1{font-size:clamp(3rem,12vw,5.5rem)}
    }
    @media(max-width:560px){
      .section{padding:75px 0}
      .services-grid,.team-grid{grid-template-columns:1fr}
      .formula-card,.big-formula,form{padding:27px 22px}
      .formula-line{grid-template-columns:repeat(7,1fr);gap:3px}
      .formula-item .circle{width:52px;height:52px;font-size:1rem}
      .formula-item small{font-size:.58rem}
      .plus{font-size:1.2rem}
      .big-equation{font-size:2.45rem}
      .footer-inner{flex-direction:column;align-items:flex-start}
    }
  
/* Ajustes extra para presentación desde celular */
@media(max-width:560px){
  .nav-inner{height:68px}
  .brand img{width:115px}
  .hero{padding-top:105px}
  .hero-logo{max-width:300px}
  .hero-sub{font-size:1.05rem}
  .hero-actions .btn{width:100%}
  .section-head{margin-bottom:35px}
  .formula-card{border-radius:22px}
  .formula-caption{font-size:.9rem}
  .statement{padding:25px}
  .quote{font-size:1.3rem}
  .big-formula{border-radius:22px}
  form{border-radius:20px}
}

</style>
</head>
<body>

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="#inicio" aria-label="3M&S inicio">
      <img src="data:image/png;base64," alt="3M&S — La fórmula digital">
    </a>
    <nav class="links" id="navLinks">
      <a href="#nosotros">Nosotros</a>
      <a href="#servicios">Servicios</a>
      <a href="#infografia">Infografía</a>
      <a href="#formula">Fórmula</a>
      <a href="#equipo">Equipo</a>
      <a class="nav-cta" href="#contacto">Hablemos</a>
    </nav>
    <button class="menu-btn" id="menuBtn" aria-label="Abrir menú">☰</button>
  </div>
</header>

<main>
  <section class="hero" id="inicio">
    <div class="container hero-grid">
      <div class="reveal">
        <img class="hero-logo" src="data:image/png;base64," alt="3M&S">
        <div class="eyebrow">Agencia de publicidad digital</div>
        <h1>La fórmula <span>digital</span> para conectar.</h1>
        <p class="hero-sub">Estrategia + creatividad + conexión = resultados. Convertimos ideas en experiencias que hacen que las marcas formen parte de la conversación.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#servicios">Conoce lo que hacemos →</a>
          <a class="btn btn-light" href="#contacto">Cuéntanos tu idea</a>
        </div>
      </div>
      <div class="formula-card reveal">
        <h3>Nuestra fórmula</h3>
        <div class="formula-line">
          <div class="formula-item"><div class="circle">M</div><small>MENSAJE</small></div>
          <div class="plus">+</div>
          <div class="formula-item"><div class="circle">M</div><small>MEDIO</small></div>
          <div class="plus">+</div>
          <div class="formula-item"><div class="circle">M</div><small>MOVIMIENTO</small></div>
          <div class="plus">=</div>
          <div class="formula-item"><div class="circle">&S</div><small>SENTIDO</small></div>
        </div>
        <p class="formula-caption">No buscamos solo llamar la atención. Buscamos generar conexión real entre las marcas y sus audiencias.</p>
      </div>
    </div>
  </section>

  <section class="section about" id="nosotros">
    <div class="container about-grid">
      <div class="about-copy reveal">
        <div class="eyebrow">Quiénes somos</div>
        <h2>Ideas que viven <span class="orange">dentro del mundo digital.</span></h2>
        <p>Somos <strong>3M&S</strong>, una agencia de publicidad especializada en marketing digital, concebida para acompañar a las marcas en su transformación dentro de los entornos digitales actuales.</p>
        <p>Combinamos <strong>estrategia y creatividad</strong> para diseñar soluciones de comunicación que conecten de manera auténtica con las audiencias.</p>
        <div class="chips">
          <span class="chip">Redes sociales</span>
          <span class="chip">Contenido</span>
          <span class="chip">Pauta digital</span>
          <span class="chip">Experiencias transmedia</span>
        </div>
      </div>
      <div class="statement reveal">
        <div class="quote-mark">“</div>
        <p class="quote">Diseñamos soluciones de comunicación para que las marcas no solo estén en el mundo digital, sino que <span class="orange">hagan parte de él.</span></p>
      </div>
    </div>
  </section>

  <section class="section" id="infografia" style="background:#fff;">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">Nuestra identidad</div>
        <h2>La historia de <span class="orange">3M&S.</span></h2>
        <p>Conoce nuestra propuesta, servicios, fórmula y equipo.</p>
      </div>
      <div class="reveal" style="background:#f7f8fa;padding:18px;border-radius:24px;box-shadow:var(--shadow);text-align:center;">
        <img src="data:image/jpeg;base64," alt="Infografía de 3M&S" style="display:block;width:100%;max-width:760px;height:auto;margin:auto;border-radius:14px;">
      </div>
    </div>
  </section>

  <section class="section" id="servicios">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">Qué hacemos</div>
        <h2>De la estrategia a la <span class="orange">experiencia.</span></h2>
        <p>Construimos ecosistemas digitales donde cada pieza tiene un propósito y cada canal aporta a una misma historia.</p>
      </div>
      <div class="services-grid">
        <article class="service reveal">
          <div class="service-icon">♡</div>
          <h3>Redes sociales</h3>
          <p>Creamos contenido que genera conversación, fortalece comunidades y convierte seguidores en audiencia.</p>
        </article>
        <article class="service reveal">
          <div class="service-icon">▶</div>
          <h3>Contenido</h3>
          <p>Desarrollamos piezas audiovisuales y narrativas que cuentan historias pensadas para cada plataforma.</p>
        </article>
        <article class="service reveal">
          <div class="service-icon">◎</div>
          <h3>Pauta digital</h3>
          <p>Conectamos las marcas con las audiencias adecuadas mediante estrategias de segmentación y distribución.</p>
        </article>
        <article class="service reveal">
          <div class="service-icon">↗</div>
          <h3>Experiencias transmedia</h3>
          <p>Expandimos una historia a través de diferentes plataformas y formatos para crear experiencias memorables.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section approach" id="formula">
    <div class="container approach-grid">
      <div class="reveal">
        <div class="eyebrow">Nuestro enfoque</div>
        <h2>Una fórmula que <span class="orange">se mueve.</span></h2>
        <p style="color:var(--muted);margin:20px 0 35px">Cada proyecto parte de una idea y evoluciona hasta convertirse en una conexión con sentido.</p>
        <div class="steps">
          <div class="step"><div class="step-num">01</div><div><h3>Estrategia</h3><p>Definimos qué queremos lograr, con quién y por qué.</p></div></div>
          <div class="step"><div class="step-num">02</div><div><h3>Creatividad</h3><p>Convertimos la estrategia en conceptos que llaman la atención.</p></div></div>
          <div class="step"><div class="step-num">03</div><div><h3>Comunicación</h3><p>Elegimos los mensajes, formatos y canales para hacerla relevante.</p></div></div>
          <div class="step"><div class="step-num">04</div><div><h3>Conexión</h3><p>Buscamos participación, conversación y relaciones que trasciendan la campaña.</p></div></div>
        </div>
      </div>
      <div class="big-formula reveal">
        <h3>3M&S — La fórmula digital</h3>
        <div class="big-equation"><span class="o">M</span> + <span class="o">M</span> + <span class="o">M</span> = <span class="o">&S</span></div>
        <p><strong>Mensaje</strong> — lo que queremos comunicar.<br>
        <strong>Medio</strong> — dónde y cómo lo comunicamos.<br>
        <strong>Movimiento</strong> — cómo hacemos que la audiencia participe.<br>
        <br>El resultado: <strong class="orange">sentido</strong>. Porque una buena campaña no solo busca atención; busca generar conexión.</p>
      </div>
    </div>
  </section>

  <section class="section" id="equipo">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">El equipo</div>
        <h2>Personas detrás de <span class="orange">las ideas.</span></h2>
        <p>Un equipo multidisciplinario que convierte conceptos en historias, contenido y experiencias digitales.</p>
      </div>
      <div class="team-grid">
        <article class="person reveal"><div class="avatar">M</div><h3>María José Castañeda</h3><span class="role">Escritura / Frente a cámara</span><p>Convierte las ideas en historias y les da voz.</p></article>
        <article class="person reveal"><div class="avatar">S</div><h3>Sara Landinez</h3><span class="role">Comunicativa</span><p>Conecta las ideas con las personas y las audiencias.</p></article>
        <article class="person reveal"><div class="avatar">M</div><h3>Manuela Cardona</h3><span class="role">Creativa</span><p>Transforma conceptos en ideas capaces de llamar la atención.</p></article>
        <article class="person reveal"><div class="avatar">M</div><h3>Martín Castañeda</h3><span class="role">Cámara / Edición</span><p>Lleva las ideas al audiovisual y construye la pieza final.</p></article>
      </div>
    </div>
  </section>

  <section class="section contact" id="contacto">
    <div class="container contact-grid">
      <div class="reveal">
        <div class="eyebrow">Hagamos algo que conecte</div>
        <h2>¿Tienes una idea?<br><span class="orange">Pongámosla en movimiento.</span></h2>
        <p class="contact-copy">Cuéntanos qué quieres comunicar y pensemos juntos una estrategia digital con sentido.</p>
        <div class="contact-points">
          <div class="contact-point"><b>01</b> Estrategia que parte de objetivos reales.</div>
          <div class="contact-point"><b>02</b> Creatividad pensada para cada audiencia.</div>
          <div class="contact-point"><b>03</b> Experiencias que viven más allá de una sola plataforma.</div>
        </div>
      </div>
      <form id="contactForm" class="reveal">
        <label for="name">Nombre</label>
        <input id="name" name="name" placeholder="Tu nombre" required>
        <label for="brand">Marca / proyecto</label>
        <input id="brand" name="brand" placeholder="¿Qué quieres impulsar?" required>
        <label for="message">Cuéntanos tu idea</label>
        <textarea id="message" name="message" placeholder="Escribe brevemente tu reto de comunicación..." required></textarea>
        <button class="btn btn-primary" type="submit">Enviar idea →</button>
        <div class="success" id="success">¡Listo! Tu idea quedó registrada para esta demo. ✦</div>
      </form>
    </div>
  </section>
</main>

<footer>
  <div class="container footer-inner">
    <div class="footer-brand">3M<span>&</span>S — La fórmula digital</div>
    <div>Estrategia + creatividad + conexión = resultados</div>
    <div>Proyecto académico · Publicidad y Transmedia</div>
  </div>
</footer>

<script>
  const menuBtn = document.getElementById('menuBtn');
  const navLinks = document.getElementById('navLinks');
  menuBtn.addEventListener('click', () => navLinks.classList.toggle('open'));
  navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if(entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, {threshold:.12});
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  document.getElementById('contactForm').addEventListener('submit', (e) => {
    e.preventDefault();
    document.getElementById('success').style.display = 'block';
    e.target.querySelector('button').textContent = 'Idea enviada ✓';
  });
</script>
</body>
</html>
